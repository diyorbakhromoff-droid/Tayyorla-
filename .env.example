# @BotFather bergan token
BOT_TOKEN=123456:ABC...
# console.anthropic.com dan olingan kalit
ANTHROPIC_API_KEY=sk-ant-...
# Saytlar ochiladigan tashqi manzil (oxirida / siz). Domen bo'lmasa: http://SERVER_IP
BASE_URL=https://tayyorla.uz
# Caddy uchun: domen bo'lsa domen nomi (tayyorla.uz), bo'lmasa :80
SITE_ADDRESS=:80
# Admin(lar) Telegram ID si, vergul bilan. ID ni @userinfobot dan bilib olasiz
ADMIN_IDS=123456789
# Rahmat to'lov havolasi
RAHMAT_URL=https://...
# Narxlar (so'm)
PRICE=25000
PRICE_STANDART=25000
PRICE_PREMIUM=49000
PRICE_VIP=79000
# Bitta sayt uchun bepul tahrirlar soni
MAX_EDITS=10
# Ma'lumotlar bazasi (Postgres uchun: postgresql+asyncpg://user:pass@host/db)
DATABASE_URL=sqlite+aiosqlite:///tayyorla.db

# ---------------------------------------------------------------- Video taklifnomalar
# Bepul videolar shu kanalga obuna bo'lganlarga yuboriladi (bot kanalda admin bo'lishi shart)
CHANNEL_ID=@tayyorlaai
# Kuniga nechta video bepul va keyingisining narxi (so'm)
FREE_VIDEOS_PER_DAY=2
VIDEO_PRICE=9900
# Balansni to'ldirish summalari (so'm, vergul bilan)
TOPUP_AMOUNTS=9900,29700,49500,99000
# Har bir mehmonga shaxsiy video paketlari: mehmonlar_soni:narx
GUEST_PACKAGES=15:39000,40:69000,100:119000,300:199000
# Video sifati: 2 => 720x1280 (tez, ~40 soniya), 3 => 1080x1920 (server kuchliroq bo'lsa)
VIDEO_SCALE=2
VIDEO_FPS=30
# Bir soatda bitta foydalanuvchi nechta video yarata oladi; tayyor videolar necha kun saqlanadi
VIDEO_MAX_PER_HOUR=10
VIDEO_KEEP_DAYS=7
